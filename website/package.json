{
  "name": "aethens-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketing site for Aethens, an open-source verifier auditor.",
  "scripts": {
    "numbers": "node scripts/generate-numbers.mjs",
    "dev": "npm run numbers && astro dev --host 127.0.0.1 --port 4321",
    "build": "npm run numbers && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "puppeteer-core": "^25.19.0"
  }
}
