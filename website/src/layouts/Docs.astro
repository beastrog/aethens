---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import DocsNav from "../components/DocsNav.astro";

interface Props {
  title: string;
  description: string;
  current: string;
}
const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base title={`${title} — Aethens`} description={description}>
  <header class="sticky top-0 z-40 border-b border-line bg-ink/95">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
      <a
        href={base}
        class="font-serif italic text-[1.35rem] leading-none tracking-tight text-paper"
      >
        Aethens
      </a>
      <nav aria-label="Section" class="flex flex-wrap items-center gap-x-5 gap-y-1">
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-gold">
          Docs
        </span>
        <a
          href="https://github.com/beastrog/aethens"
          class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted hover:text-paper"
        >
          GitHub
        </a>
      </nav>
    </div>
  </header>
  <main id="main">
    <div class="wrap py-12 sm:py-16 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
      <DocsNav current={current} />
      <article class="min-w-0 max-w-3xl">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</Base>
