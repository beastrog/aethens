---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DocsNav from "../components/DocsNav.astro";

interface Props {
  title: string;
  description: string;
  current: string;
}
const { title, description, current } = Astro.props;
---

<Base title={`${title} — Aethens`} description={description}>
  <Header />
  <main id="main">
    <div class="wrap py-12 sm:py-16 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
      <DocsNav current={current} />
      <article class="min-w-0 max-w-3xl">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</Base>
