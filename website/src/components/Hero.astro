---
const command = `pipx install aethens
docker pull python:3.12-slim
aethens audit path/to/task --format markdown`;
---

<section id="top" class="relative" aria-labelledby="hero-heading">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold to-transparent"
    aria-hidden="true"
  ></div>
  <div class="wrap pt-16 pb-14 sm:pt-24 sm:pb-20">
    <p class="kicker mb-8">
      <span>Open source</span>
      <span class="num" aria-hidden="true">/</span>
      <span>Apache-2.0</span>
      <span class="num" aria-hidden="true">/</span>
      <span>0.1.0</span>
      <span class="num" aria-hidden="true">/</span>
      <span>Python tasks</span>
    </p>

    <h1
      id="hero-heading"
      class="font-serif italic font-semibold text-display leading-[0.95] tracking-[-0.03em] max-w-5xl"
    >
      Audit the tests that score your agents.
    </h1>

    <p class="mt-8 max-w-2xl text-lg sm:text-xl text-paper/90 leading-relaxed">
      It runs a task’s verifier in Docker and reports tests that accept a wrong solution, reject a right one, or change their answer between runs.
    </p>

    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      <div>
        <p class="cmd-label">Install and run</p>
        <div class="cmd-frame">
          <pre class="cmd" tabindex="0"><code id="install-cmd">{command}</code></pre>
          <button type="button" class="copy-btn" data-copy-target="install-cmd">Copy</button>
        </div>
        <p class="mt-2 text-xs text-muted">
          <code class="text-gold">uv tool install aethens</code> and{' '}
          <code class="text-gold">pip install aethens</code> install the same release.
          From a clone, <code class="text-gold">python -m pip install .</code>{' '}
          Needs Docker and Python 3.11+.
        </p>
      </div>
      <div>
        <p class="cmd-label">Report lines, typed</p>
        <pre class="term" id="cli-demo" tabindex="0" aria-hidden="true"></pre>
        <p class="sr-only">
          aethens audit bench/tasks/order-alphabetical --check C005 --seed 0 --budget smoke.
          1 error, 0 warning, 0 info.
          error, C005, order-alphabetical.
          Test verdict depends on test order or isolation: test_reg.TestRegistry.test_b_lookup.
          Observed: default order: pass; in reversed order: error.
        </p>
        <p class="mt-2 text-xs text-muted">
          Lines from a real report,{' '}
          <code class="text-gold">data/report-order-alphabetical.md</code>
          {' '}(local run, 27 Nov 2026, aethens 0.1.0.dev0). Not a mock-up.
          <a class="prose-link" href={`${import.meta.env.BASE_URL}how-it-works/#report`}>Full report</a>.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const demo = document.getElementById("cli-demo");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const lines = [
    "$ aethens audit bench/tasks/order-alphabetical --check C005 --seed 0 --budget smoke",
    "",
    "1 error, 0 warning, 0 info",
    "error  C005  order-alphabetical",
    "Test verdict depends on test order or isolation: test_reg.TestRegistry.test_b_lookup",
    "Observed: default order: pass; in reversed order: error",
  ];
  const paint = (n: number) => {
    if (!demo) return;
    demo.textContent = lines.slice(0, n).join("\n");
  };
  if (!demo) {
    /* no demo node */
  } else if (reduce.matches) {
    paint(lines.length);
  } else {
    let i = 0;
    let pos = 0;
    const step = () => {
      if (reduce.matches) {
        paint(lines.length);
        return;
      }
      i += 1;
      if (i > lines[pos].length) {
        pos += 1;
        i = 0;
        if (pos >= lines.length) {
          paint(lines.length);
          return;
        }
      }
      demo.textContent = lines.slice(0, pos).concat(lines[pos].slice(0, i)).join("\n");
      window.setTimeout(step, lines[pos] === "" ? 180 : 16);
    };
    step();
  }
</script>
