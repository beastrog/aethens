---
const links = [
  { href: "#problem", label: "Problem" },
  { href: "#checks", label: "Checks" },
  { href: "#accuracy", label: "Accuracy" },
  { href: "#compare", label: "Compare" },
  { href: "#report", label: "Report" },
  { href: "#audits", label: "Audits" },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/95">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
    <a href="#top" class="font-serif italic text-[1.35rem] leading-none tracking-tight text-paper">
      Aethens
    </a>
    <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-5 gap-y-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted hover:text-paper"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="https://github.com/beastrog/aethens"
        class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-gold hover:text-gold-bright"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>
