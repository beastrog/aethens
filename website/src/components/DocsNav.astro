---
interface Props {
  current: string;
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { slug: "getting-started", href: `${base}docs/`, label: "Getting started" },
  { slug: "cli", href: `${base}docs/cli/`, label: "CLI" },
  { slug: "checks", href: `${base}docs/checks/`, label: "Checks" },
  { slug: "action", href: `${base}docs/action/`, label: "GitHub Action" },
  { slug: "report", href: `${base}docs/report/`, label: "Report format" },
  { slug: "faq", href: `${base}docs/faq/`, label: "FAQ and limits" },
  { slug: "findings", href: `${base}findings/`, label: "Findings" },
];
---

<nav aria-label="Documentation" class="mb-10 lg:mb-0 lg:sticky lg:top-20">
  <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-muted mb-3">
    Docs
  </p>
  <ul class="flex flex-col gap-1">
    {
      links.map((l) => {
        const active = current === l.slug;
        return (
          <li>
            <a
              href={l.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "block py-1 font-mono text-[0.78rem] tracking-[0.04em]",
                active ? "text-gold" : "text-muted hover:text-paper",
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
