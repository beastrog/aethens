---
// Interactive "audit field" behind the hero. Decorative only: aria-hidden,
// not focusable (no tabindex), pointer-events none (input is read from window listeners).
// The script lazy-inits after load, so it never competes with first paint/LCP.
---

<div class="hero-field" aria-hidden="true" data-hero-field>
  <canvas class="hero-field__canvas"></canvas>
  <div class="hero-field__scrim"></div>
</div>

<style>
  .hero-field {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(100%, max(100svh, 48rem));
    z-index: -1;
    pointer-events: none;
    user-select: none;
    overflow: hidden;
  }
  .hero-field__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-field:global(.is-ready) .hero-field__canvas {
    opacity: 1;
  }
  /* Scrim: keeps the headline column and copy at full contrast. */
  .hero-field__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 62% 58% at 22% 40%, rgba(9, 10, 12, 0.82) 0%, rgba(9, 10, 12, 0.5) 45%, rgba(9, 10, 12, 0) 78%),
      linear-gradient(to bottom, rgba(9, 10, 12, 0) 55%, var(--color-ink) 100%);
  }
  @media (max-width: 759px) {
    .hero-field__scrim {
      background:
        linear-gradient(to bottom, rgba(9, 10, 12, 0.1) 0%, rgba(9, 10, 12, 0.5) 30%, rgba(9, 10, 12, 0.66) 60%, var(--color-ink) 100%);
    }
  }
</style>

<script>
  import { mountHeroField } from "../scripts/hero-field";

  const root = document.querySelector<HTMLElement>("[data-hero-field]");
  if (root && typeof ResizeObserver !== "undefined" && typeof IntersectionObserver !== "undefined") {
    const start = () => {
      const run = () => mountHeroField(root);
      if ("requestIdleCallback" in window) {
        (window as Window & typeof globalThis).requestIdleCallback(run, { timeout: 1500 });
      } else {
        setTimeout(run, 200);
      }
    };
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>
